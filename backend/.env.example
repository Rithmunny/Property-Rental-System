# Local Docker Postgres (docker compose up -d)
DATABASE_URL="postgresql://prs:prs@localhost:5433/prs?schema=public"
DIRECT_URL="postgresql://prs:prs@localhost:5433/prs?schema=public"

# Optional hosted Postgres: replace PROJECT_REF and PASSWORD from your provider
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@HOST:5432/postgres"

JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="7d"
PORT=5000
FRONTEND_ORIGIN="http://localhost:5173"
